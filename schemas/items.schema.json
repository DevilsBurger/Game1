{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "arken/items",
 "title": "Items",
 "type": "object",
 "properties": {
  "version": {
   "type": "integer"
  },
  "count": {
   "type": "integer"
  },
  "by_category": {
   "type": "object",
   "properties": {},
   "required": [],
   "additionalProperties": true
  },
  "prices": {
   "type": "object",
   "properties": {},
   "required": [],
   "additionalProperties": true
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[CIERASNXM][0-9]{2,3}$"
     },
     "name_ko": {
      "type": "string"
     },
     "name_en": {
      "type": "string"
     },
     "category": {
      "type": "string",
      "enum": [
       "component",
       "completed",
       "emblem",
       "radiant",
       "artifact",
       "support",
       "national",
       "consumable",
       "material"
      ]
     },
     "stats": {
      "type": "object",
      "properties": {
       "ad_pct": {
        "type": "number"
       },
       "ap": {
        "type": "number"
       },
       "hp": {
        "type": "number"
       },
       "armor": {
        "type": "number"
       },
       "mr": {
        "type": "number"
       },
       "as_pct": {
        "type": "number"
       },
       "mana": {
        "type": "number"
       },
       "crit": {
        "type": "number"
       },
       "omnivamp": {
        "type": "number"
       },
       "durability": {
        "type": "number"
       }
      },
      "required": [],
      "additionalProperties": false
     },
     "hooks": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "stack_ad_on_kill",
          "giant_slayer",
          "low_hp_shield",
          "shred_on_hit",
          "omnivamp_bonus",
          "aoe_on_attack",
          "mana_on_attack",
          "crit_dmg_bonus",
          "heal_on_kill",
          "start_shield",
          "burn_on_hit",
          "shield_on_cast",
          "as_stack_on_attack",
          "mana_refund_on_cast",
          "spell_crit",
          "burn_aura",
          "as_slow_aura",
          "stack_on_hit",
          "heal_allies_timer",
          "thorns",
          "gargoyle",
          "shred_on_crit",
          "magic_dr",
          "shock_every_n",
          "cast_mana_allies",
          "cc_immune",
          "extra_range",
          "ap_stack_timer",
          "hand_of_justice",
          "mana_on_kill",
          "mana_regen",
          "random_items",
          "shield_on_crit",
          "overheal_shield",
          "revive",
          "heal_on_revive_allies",
          "aura_allies",
          "aura_enemies",
          "regen",
          "kill_explode",
          "execute_low",
          "dodge",
          "true_dmg_on_cast",
          "heal_on_cast_allies",
          "summon_on_kill",
          "summon_on_cast",
          "first_cast_bonus",
          "slow_on_cast",
          "stasis_low_hp",
          "backline_jump",
          "dash_dmg_bonus",
          "turret_stat_bonus",
          "as_pct_penalty",
          "grant_trait",
          "double_trait_count",
          "team_slot",
          "gold_bonus",
          "drop_bonus",
          "hero_drop_bonus"
         ]
        },
        "params": {
         "type": "object",
         "properties": {},
         "required": [],
         "additionalProperties": true
        }
       },
       "required": [
        "type",
        "params"
       ],
       "additionalProperties": true
      }
     },
     "desc": {
      "type": "string"
     },
     "price_gold": {
      "type": [
       "integer",
       "null"
      ]
     },
     "price_gem": {
      "type": "integer"
     },
     "recipe": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      }
     },
     "base_item": {
      "type": "string"
     },
     "nation": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "effect": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
     },
     "grade": {
      "type": "string"
     },
     "balance": {
      "type": "object",
      "properties": {
       "mult": {
        "type": "number"
       },
       "flag": {
        "type": "string"
       }
      },
      "required": [
       "mult"
      ],
      "additionalProperties": true
     }
    },
    "required": [
     "id",
     "name_ko",
     "name_en",
     "category",
     "stats",
     "hooks",
     "desc"
    ],
    "additionalProperties": true
   }
  }
 },
 "required": [
  "version",
  "count",
  "items"
 ],
 "additionalProperties": true
}